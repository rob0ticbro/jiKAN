{
  "name": "jikan",
  "version": "1.2.0",
  "license": "GPL-3.0-only",
  "private": true,
  "author": "jiKAN contributors",
  "desktopName": "jiKAN",
  "description": "jiKAN — 時計, an offline flip clock and focus timer for Linux",
  "scripts": {
    "app:dev": "electron .",
    "app:build": "electron-builder --linux AppImage"
  },
  "main": "main.cjs",
  "build": {
    "appId": "app.hour.jikan",
    "productName": "jiKAN",
    "artifactName": "jiKAN-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "LICENSE",
      "COPYRIGHT",
      "assets/**/*"
    ],
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/jikan.png",
      "synopsis": "Offline flip clock and focus timer",
      "description": "A local flip clock, countdown, and Pomodoro timer with custom themes and an in-app screensaver."
    }
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
